# Copy this file to .env.local and fill in the values from
# Supabase > Project Settings > API Keys (and Data API for the URL).
# .env.local is git-ignored, so these never reach GitHub.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
